# ── Secrets & local configuration ────────────────────────────────────────────
# .env holds local values (ports, later LLM keys). Only .env.example is shared.
.env
.env.*
!.env.example

# ── JavaScript / TypeScript ──────────────────────────────────────────────────
node_modules/
dist/
coverage/
*.tsbuildinfo

# WXT (extension build tool) output and generated types
.output/
.wxt/
*.zip

# Extension signing key (never commit; generated locally)
extension.pem
extension.crx

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# ── Databases / runtime data ─────────────────────────────────────────────────
*.db
*.db-journal
backend/data/

# ── Agent tooling ────────────────────────────────────────────────────────────
# Graphify's generated knowledge graph; rebuild it with `graphify update .`.
# The skill itself (.claude/skills/) is committed, so both of us have it.
graphify-out/
# Personal Claude Code settings (permissions) differ per machine.
.claude/settings.local.json

# ── Editors & operating systems ──────────────────────────────────────────────
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
