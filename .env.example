# Project Pocket — local configuration template.
#
# Usage:  cp .env.example .env
# Docker Compose reads `.env` automatically. Never commit `.env`.
# There are no secrets in the scaffold yet; when an LLM API key is added it
# must only ever live in `.env` (git-ignored) and be documented here as a
# placeholder, never with a real value.

# "development" or "production". Currently only used for logging/display.
POCKET_ENVIRONMENT=development

# Comma-separated list of origins allowed to call the API from a browser.
# 5173 = Vite dev server, 3000 = web app served by Docker/nginx.
POCKET_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Host ports used by docker-compose.yml.
WEB_PORT=3000
BACKEND_PORT=8000

# Allow new local accounts. Set to false on a publicly reachable server.
POCKET_ALLOW_REGISTRATION=true
# Days until a local login expires.
POCKET_TOKEN_LIFETIME_DAYS=30

# Optional Keycloak login. Leave empty to use local accounts only.
# Issuer and client ID must be set together.
POCKET_OIDC_ISSUER=
POCKET_OIDC_CLIENT_ID=
# Only needed if the backend reaches Keycloak under another address than the browser.
POCKET_OIDC_JWKS_URL=
