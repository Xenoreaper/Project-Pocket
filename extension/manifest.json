{
  "manifest_version": 3,
  "name": "Project Pocket",
  "version": "1.0.0",
  "description": "Save the current page to Project Pocket.",
  "permissions": ["activeTab", "tabs", "storage", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
