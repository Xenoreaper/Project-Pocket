{
  "manifest_version": 2,
  "name": "Project Pocket",
  "version": "1.0.0",
  "description": "Save the current page to Project Pocket.",
  "permissions": ["activeTab", "tabs", "storage", "contextMenus", "<all_urls>"],
  "applications": {
    "gecko": {
      "id": "{a3f7c2d8-5e1b-4a9f-8c3e-2d6b0f4e7a1c}",
      "strict_min_version": "91.0"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
