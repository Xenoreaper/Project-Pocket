{
  "realm": "pocket",
  "displayName": "Project Pocket",
  "enabled": true,
  "registrationAllowed": false,
  "sslRequired": "external",
  "bruteForceProtected": true,
  "clients": [
    {
      "clientId": "project-pocket",
      "name": "Project Pocket",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["${POCKET_PUBLIC_URL}/*"],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${POCKET_PUBLIC_URL}/*"
      }
    }
  ]
}
