# Project Pocket — configuration template for a server behind a reverse proxy.
#
# Usage on the server:  cp docker/server/server.env.example .env
# Then fill in every CHANGE_ME value. Never commit the resulting `.env`.
# docs/DEPLOYMENT.md explains each step.

# ── Compose ──────────────────────────────────────────────────────────────────
# The files Compose merges, in order. Remove the last file and the profile to
# run without Keycloak (local accounts only).
COMPOSE_FILE=docker-compose.yml:docker-compose.server.yml:docker-compose.server-keycloak.yml
COMPOSE_PROFILES=keycloak
# Docker network that the reverse proxy shares with the app.
PROXY_NETWORK=proxy-pocket

# ── Backend ──────────────────────────────────────────────────────────────────
POCKET_ENVIRONMENT=production
# The server is public, so nobody can create a local account. Users log in
# through Keycloak. Without Keycloak, set this to true while you register.
POCKET_ALLOW_REGISTRATION=false
POCKET_TOKEN_LIFETIME_DAYS=30
# Web app origin. The browser calls the API on the same origin, so this only
# matters for other clients.
POCKET_CORS_ORIGINS=https://pocket.example.org

# ── Keycloak ─────────────────────────────────────────────────────────────────
# Public addresses, without a trailing slash.
POCKET_PUBLIC_URL=https://pocket.example.org
KEYCLOAK_PUBLIC_URL=https://auth.example.org
# The issuer is the Keycloak address plus /realms/pocket.
POCKET_OIDC_ISSUER=https://auth.example.org/realms/pocket
POCKET_OIDC_CLIENT_ID=project-pocket
# The backend fetches the signing keys inside the Docker network.
POCKET_OIDC_JWKS_URL=http://keycloak:8080/realms/pocket/protocol/openid-connect/certs

# SECRETS — generate each one with:  openssl rand -base64 24
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
KEYCLOAK_DB_PASSWORD=CHANGE_ME
